---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import DeviceShowcase from "../components/DeviceShowcase.astro";
import { withBase } from "../lib/url";
import { site, included, examples, steps, faqs } from "../data/site";
---

<BaseLayout>
  <!-- ================= HEADER ================= -->
  <header class="sticky top-0 z-50 border-b border-line bg-paper/85 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
      <a href="#top" class="flex items-center gap-2.5 font-display text-lg font-700 tracking-tight text-ink">
        <span class="grid h-8 w-8 place-items-center rounded-lg bg-ink text-accent-400">P</span>
        {site.studioName}
      </a>
      <nav class="hidden items-center gap-8 text-sm font-500 text-ink-soft md:flex">
        <a href="#included" class="transition-colors hover:text-accent-600">What you get</a>
        <a href="#work" class="transition-colors hover:text-accent-600">Examples</a>
        <a href="#how" class="transition-colors hover:text-accent-600">How it works</a>
        <a href="#faq" class="transition-colors hover:text-accent-600">FAQ</a>
      </nav>
      <a
        href="#contact"
        class="rounded-full bg-accent-600 px-5 py-2.5 text-sm font-600 text-white shadow-sm transition-all hover:bg-accent-700 hover:shadow-md"
      >
        Get a free look
      </a>
    </div>
  </header>

  <main id="top">
    <!-- ================= HERO ================= -->
    <section class="grain relative overflow-hidden">
      <div class="grid-lines pointer-events-none absolute inset-0"></div>
      <div class="pointer-events-none absolute -top-40 right-0 h-[32rem] w-[32rem] rounded-full bg-accent-100 opacity-60 blur-3xl"></div>
      <div class="relative mx-auto max-w-6xl px-5 pb-24 pt-14 md:pb-32 md:pt-20">
        <div class="grid items-center gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-16">
          <div data-reveal>
            <span class="inline-flex items-center gap-2 rounded-full border border-line bg-white/60 px-4 py-1.5 text-sm font-500 text-ink-soft">
              <span class="relative flex h-2 w-2">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent-400 opacity-75"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-accent-500"></span>
              </span>
              Local developer, not a faceless agency
            </span>
            <h1 class="mt-6 font-display text-[2.6rem] font-700 leading-[1.02] text-ink sm:text-5xl md:text-[3.6rem]">
              A professional website for your business.
              <span class="text-accent-600">{site.offer.price}, {site.offer.timeline}.</span>
            </h1>
            <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
              Fast, mobile-friendly, and built to bring you calls and bookings — by a
              software developer based in {site.location}. No templates with your name
              pasted in. No monthly lock-in. Just a site that works.
            </p>
            <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
              <a
                href="#contact"
                class="group inline-flex items-center justify-center gap-2 rounded-full bg-accent-600 px-7 py-3.5 text-base font-600 text-white shadow-lift transition-all hover:-translate-y-0.5 hover:bg-accent-700"
              >
                Get a free look at your site
                <Icon name="arrow-right" size={18} class="transition-transform group-hover:translate-x-1" />
              </a>
              <a
                href="#work"
                class="inline-flex items-center justify-center gap-2 rounded-full border border-line bg-white/50 px-7 py-3.5 text-base font-600 text-ink transition-colors hover:bg-white"
              >
                See real examples
              </a>
            </div>
            <p class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted">
              <Icon name="zap" size={15} class="text-accent-500" />
              <span id="speed-note">Built to load fast on any connection — yours will be too.</span>
            </p>
          </div>

          <div data-reveal style="--reveal-delay:120ms">
            <DeviceShowcase />
          </div>
        </div>
      </div>
    </section>

    <!-- ================= STATS ================= -->
    <section class="border-y border-line bg-sand">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
        {[
          { n: "7", suffix: "+", label: "years building software", sub: "professionally, day in day out" },
          { n: "6", suffix: "", label: "sites you can click", sub: "not mockups — real, live builds" },
          { n: "2", suffix: " wks", label: "from content to live", sub: "start to finish, predictable" },
          { n: "1", suffix: "", label: "fixed price", sub: "no hourly creep, no surprises" },
        ].map((s) => (
          <div>
            <div class="font-display text-4xl font-700 tracking-tight text-ink">
              <span data-count-to={s.n}>0</span>{s.suffix}
            </div>
            <div class="mt-1 font-500 text-ink-soft">{s.label}</div>
            <div class="text-sm text-muted">{s.sub}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- ================= INCLUDED ================= -->
    <section id="included" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-20 md:py-28">
      <div class="max-w-2xl" data-reveal>
        <h2 class="font-display text-3xl font-700 text-ink md:text-4xl">What the {site.offer.price} gets you</h2>
        <p class="mt-4 text-lg text-muted">
          One fixed package. Everything a small business actually needs to look
          professional and get found — nothing you don't.
        </p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {included.map((item, i) => (
          <div
            data-reveal
            style={`--reveal-delay:${i * 70}ms`}
            class="group rounded-card border border-line bg-white/60 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-accent-400 hover:bg-white hover:shadow-lift"
          >
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-accent-100 text-accent-600 transition-colors duration-300 group-hover:bg-accent-600 group-hover:text-white">
              <Icon name={item.icon} size={24} />
            </span>
            <h3 class="mt-5 font-display text-lg font-600 text-ink">{item.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">{item.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ================= EXAMPLES ================= -->
    <section id="work" class="scroll-mt-20 border-y border-line bg-sand">
      <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
        <div class="max-w-2xl" data-reveal>
          <h2 class="font-display text-3xl font-700 text-ink md:text-4xl">See it for real</h2>
          <p class="mt-4 text-lg text-muted">
            Demo sites for local businesses like yours, plus a couple of bigger
            builds to show the range. Every one is live — click through and try them.
            Best viewed on your phone; that's where your customers are.
          </p>
        </div>
        <div class="mt-12 grid gap-8 md:grid-cols-2">
          {examples.map((ex, i) => {
            const Tag = ex.url ? "a" : "div";
            const linkProps = ex.url ? { href: ex.url, target: "_blank", rel: "noopener" } : {};
            let host = "";
            try { host = ex.url ? new URL(ex.url).host : ""; } catch (e) { host = ""; }
            return (
              <Tag
                {...linkProps}
                data-reveal
                style={`--reveal-delay:${(i % 2) * 90}ms`}
                class:list={[
                  "group block overflow-hidden rounded-card border border-line bg-white transition-all duration-300",
                  ex.url ? "hover:-translate-y-1.5 hover:shadow-float" : "",
                ]}
              >
                <div class="flex items-center gap-2 border-b border-line bg-sand/70 px-3 py-2">
                  <span class="flex gap-1.5">
                    <span class="h-2 w-2 rounded-full bg-[#f0685f]"></span>
                    <span class="h-2 w-2 rounded-full bg-[#f7bf4f]"></span>
                    <span class="h-2 w-2 rounded-full bg-[#61c554]"></span>
                  </span>
                  <span class="mx-auto max-w-[75%] truncate rounded bg-white/80 px-2.5 py-0.5 text-[11px] font-500 text-muted">
                    {host || "private build"}
                  </span>
                </div>
                <div class="aspect-[16/10] overflow-hidden border-b border-line bg-sand">
                  <img
                    src={withBase(ex.image)}
                    alt={`${ex.name} — example website`}
                    width="800"
                    height="500"
                    loading="lazy"
                    class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
                  />
                </div>
                <div class="p-6">
                  <span class="text-xs font-600 uppercase tracking-wider text-accent-600">{ex.kind}</span>
                  <h3 class="mt-2 flex items-center gap-2 font-display text-xl font-600 text-ink">
                    {ex.name}
                    {ex.url ? (
                      <Icon name="external-link" size={16} class="text-muted transition-colors group-hover:text-accent-600" />
                    ) : (
                      <span class="rounded-full bg-sand px-2 py-0.5 text-[11px] font-600 uppercase tracking-wide text-muted">Private build</span>
                    )}
                  </h3>
                  <p class="mt-2 text-[15px] leading-relaxed text-muted">{ex.goal}</p>
                </div>
              </Tag>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ================= HOW IT WORKS ================= -->
    <section id="how" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-20 md:py-28">
      <div class="max-w-2xl" data-reveal>
        <h2 class="font-display text-3xl font-700 text-ink md:text-4xl">How it works</h2>
        <p class="mt-4 text-lg text-muted">
          Simple and predictable from the first call to launch day. No mystery, no
          endless back-and-forth.
        </p>
      </div>
      <div class="relative mt-12">
        <!-- The thread connecting the four steps -->
        <div class="pointer-events-none absolute left-0 right-0 top-13 hidden h-px bg-linear-to-r from-transparent via-line to-transparent lg:block"></div>
        <div class="relative grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {steps.map((step, i) => (
            <div
              data-reveal
              style={`--reveal-delay:${i * 90}ms`}
              class="group relative rounded-card border border-line bg-white/60 p-6 transition-all duration-300 hover:-translate-y-1 hover:bg-white hover:shadow-lift"
            >
              <span class="grid h-11 w-11 place-items-center rounded-full border border-line bg-paper font-display text-lg font-700 text-accent-600 transition-colors duration-300 group-hover:border-accent-600 group-hover:bg-accent-600 group-hover:text-white">
                {step.n}
              </span>
              <h3 class="mt-4 font-display text-lg font-600 text-ink">{step.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-muted">{step.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= PRICING ================= -->
    <section class="mx-auto max-w-6xl px-5 pb-20 md:pb-28">
      <div class="grid gap-6 lg:grid-cols-3">
        <!-- Build -->
        <div class="grain relative overflow-hidden rounded-card bg-ink p-8 text-white shadow-float lg:col-span-2" data-reveal>
          <div class="pointer-events-none absolute -right-16 -top-20 h-64 w-64 rounded-full bg-accent-500/20 blur-3xl"></div>
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <span class="text-sm font-600 uppercase tracking-wider text-accent-400">The website</span>
              <div class="mt-2 flex items-baseline gap-2">
                <span class="font-display text-5xl font-700">{site.offer.price}</span>
                <span class="text-white/60">one-off, {site.offer.timeline}</span>
              </div>
            </div>
            <a
              href="#contact"
              class="rounded-full bg-accent-500 px-6 py-3 text-sm font-600 text-white transition-colors hover:bg-accent-400 hover:text-ink"
            >
              Start yours
            </a>
          </div>
          <ul class="mt-8 grid gap-3 sm:grid-cols-2">
            {included.map((item) => (
              <li class="flex items-start gap-2.5 text-[15px] text-white/85">
                <Icon name="check" size={18} class="mt-0.5 shrink-0 text-accent-400" />
                {item.title}
              </li>
            ))}
          </ul>
          <p class="mt-7 border-t border-white/10 pt-5 text-sm text-white/60">
            £200 to book your slot, the balance (£299) before it goes live. Your domain stays in your name.
          </p>
        </div>
        <!-- Care plan -->
        <div class="rounded-card border border-line bg-white/60 p-8" data-reveal style="--reveal-delay:110ms">
          <span class="text-sm font-600 uppercase tracking-wider text-accent-600">Optional care plan</span>
          <div class="mt-2 flex items-baseline gap-2">
            <span class="font-display text-4xl font-700 text-ink">{site.offer.carePrice}</span>
          </div>
          <p class="mt-4 text-[15px] leading-relaxed text-muted">
            Keep it running without lifting a finger. Cancel anytime — no lock-in.
          </p>
          <ul class="mt-6 space-y-3 text-[15px] text-ink-soft">
            {[
              "Hosting, SSL & domain looked after",
              "Uptime monitoring — fixed before you notice",
              "Up to 30 min of changes each month",
              "A monthly nudge in case anything needs updating",
            ].map((line) => (
              <li class="flex items-start gap-2.5">
                <Icon name="check" size={18} class="mt-0.5 shrink-0 text-accent-500" />
                {line}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ================= FAQ ================= -->
    <section id="faq" class="scroll-mt-20 border-y border-line bg-sand">
      <div class="mx-auto max-w-3xl px-5 py-20 md:py-28">
        <div data-reveal>
          <h2 class="font-display text-3xl font-700 text-ink md:text-4xl">Straight answers</h2>
          <p class="mt-4 text-lg text-muted">The questions I get asked most.</p>
        </div>
        <div class="mt-10 space-y-3">
          {faqs.map((faq, i) => (
            <details
              data-reveal
              style={`--reveal-delay:${i * 55}ms`}
              class="group rounded-card border border-line bg-white/70 px-6 transition-colors open:shadow-lift hover:border-accent-400/60"
            >
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-display text-lg font-600 text-ink">
                {faq.q}
                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full border border-line text-accent-600 transition-transform group-open:rotate-45">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" x2="12" y1="5" y2="19"/><line x1="5" x2="19" y1="12" y2="12"/></svg>
                </span>
              </summary>
              <p class="pb-6 pr-10 text-[15px] leading-relaxed text-muted">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= CONTACT ================= -->
    <section id="contact" class="scroll-mt-20">
      <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
        <div class="grid gap-12 lg:grid-cols-2">
          <div>
            <h2 class="font-display text-3xl font-700 text-ink md:text-4xl">Let's have a look at your site</h2>
            <p class="mt-4 text-lg leading-relaxed text-muted">
              Tell me a bit about your business and I'll send back a free, no-strings
              review of your current site — or a quick idea of what a new one could look
              like. Reply usually within a day.
            </p>
            <ul class="mt-8 space-y-4 text-ink-soft">
              <li class="flex items-center gap-3">
                <span class="grid h-10 w-10 place-items-center rounded-xl bg-accent-100 text-accent-600"><Icon name="mail" size={20} /></span>
                <span class="font-500">Drop me a message using the form &rarr;</span>
              </li>
              {site.phoneDisplay && (
                <li class="flex items-center gap-3">
                  <span class="grid h-10 w-10 place-items-center rounded-xl bg-accent-100 text-accent-600"><Icon name="phone" size={20} /></span>
                  <a href={site.phoneHref} class="font-500 hover:text-accent-600">{site.phoneDisplay}</a>
                </li>
              )}
              <li class="flex items-center gap-3">
                <span class="grid h-10 w-10 place-items-center rounded-xl bg-accent-100 text-accent-600"><Icon name="map-pin" size={20} /></span>
                <span class="font-500">{site.location}</span>
              </li>
            </ul>
          </div>

          <form
            action="https://api.web3forms.com/submit"
            method="POST"
            class="rounded-card border border-line bg-white p-7 shadow-sm"
          >
            <input type="hidden" name="access_key" value={site.web3formsKey} />
            <input type="hidden" name="subject" value="New enquiry from Petrov Web Design" />
            <input type="hidden" name="from_name" value="Petrov Web Design website" />
            <!-- Honeypot -->
            <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

            <div class="grid gap-4">
              <label class="block">
                <span class="text-sm font-600 text-ink">Your name</span>
                <input
                  type="text" name="name" required
                  class="mt-1.5 w-full rounded-xl border border-line bg-paper px-4 py-3 text-ink outline-none transition-colors focus:border-accent-500 focus:bg-white"
                />
              </label>
              <div class="grid gap-4 sm:grid-cols-2">
                <label class="block">
                  <span class="text-sm font-600 text-ink">Email</span>
                  <input
                    type="email" name="email" required
                    class="mt-1.5 w-full rounded-xl border border-line bg-paper px-4 py-3 text-ink outline-none transition-colors focus:border-accent-500 focus:bg-white"
                  />
                </label>
                <label class="block">
                  <span class="text-sm font-600 text-ink">Business name <span class="font-400 text-muted">(optional)</span></span>
                  <input
                    type="text" name="business"
                    class="mt-1.5 w-full rounded-xl border border-line bg-paper px-4 py-3 text-ink outline-none transition-colors focus:border-accent-500 focus:bg-white"
                  />
                </label>
              </div>
              <label class="block">
                <span class="text-sm font-600 text-ink">What do you need?</span>
                <textarea
                  name="message" rows="4" required
                  placeholder="A few lines about your business and what you're after — a new site, a rebuild, or just a look at what you've got."
                  class="mt-1.5 w-full rounded-xl border border-line bg-paper px-4 py-3 text-ink outline-none transition-colors placeholder:text-muted/70 focus:border-accent-500 focus:bg-white"
                ></textarea>
              </label>
              <button
                type="submit"
                class="mt-1 inline-flex items-center justify-center gap-2 rounded-full bg-accent-600 px-7 py-3.5 text-base font-600 text-white transition-colors hover:bg-accent-700"
              >
                Send it over
                <Icon name="arrow-right" size={18} />
              </button>
              <p class="text-center text-xs text-muted">
                Goes straight to my inbox. No spam, no list — I'll just reply.
              </p>
            </div>
          </form>
        </div>
      </div>
    </section>
  </main>

  <!-- ================= FOOTER ================= -->
  <footer class="border-t border-line bg-ink text-white/70">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-10 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <div class="flex items-center gap-2.5 font-display text-lg font-700 text-white">
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-accent-500 text-ink">P</span>
          {site.studioName}
        </div>
        <p class="mt-3 text-sm">Websites for local businesses · {site.location}</p>
      </div>
      <div class="flex items-center gap-5">
        <a href={site.links.portfolio} target="_blank" rel="noopener" class="text-sm font-500 transition-colors hover:text-accent-400">Portfolio</a>
        <a href={site.links.github} target="_blank" rel="noopener" aria-label="GitHub" class="transition-colors hover:text-accent-400"><Icon name="github" size={20} /></a>
        <a href={site.links.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="transition-colors hover:text-accent-400"><Icon name="linkedin" size={20} /></a>
        <a href={withBase("privacy")} class="text-sm transition-colors hover:text-accent-400">Privacy</a>
      </div>
    </div>
  </footer>

  <!-- Real measured render time, from this visitor's own browser. Uses first
       contentful paint (when they actually saw the page). Only upgrades the
       sentence when the number is genuinely good — a visitor on a bad connection
       keeps the plain claim rather than being shown a slow number. -->
  <script is:inline>
    (function () {
      var el = document.getElementById("speed-note");
      if (!el) return;
      function report() {
        var ms = 0;
        try {
          var fcp = performance.getEntriesByName("first-contentful-paint")[0];
          if (fcp) ms = fcp.startTime;
          if (!ms) {
            var nav = performance.getEntriesByType("navigation")[0];
            if (nav) ms = nav.domInteractive - nav.startTime;
          }
        } catch (e) { return; }
        if (!ms || ms < 1 || ms > 1200) return;
        el.innerHTML =
          'This page rendered in <b class="font-600 text-ink">' +
          Math.round(ms) + 'ms</b> on your device — that\'s the standard yours gets built to.';
      }
      if (document.readyState === "complete") report();
      else window.addEventListener("load", function () { setTimeout(report, 0); });
    })();
  </script>
</BaseLayout>
