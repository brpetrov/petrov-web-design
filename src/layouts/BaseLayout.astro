---
import "../styles/global.css";
import { site } from "../data/site";
import { withBase } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
}
const { title = site.seo.title, description = site.seo.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.studioName,
  description: site.seo.description,
  areaServed: site.location,
  url: Astro.site?.toString(),
  founder: { "@type": "Person", name: site.owner },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Leeds",
    addressRegion: "West Yorkshire",
    addressCountry: "GB",
  },
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.studioName} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="antialiased">
    <slot />

    <!-- Regional pricing: eurozone visitors (incl. Bulgaria & Malta) see € prices.
         Display-only text swap — SEO meta, invoices and contracts stay in GBP. -->
    <script is:inline>
      (function () {
        var EUR_TZ = [
          "Europe/Sofia", "Europe/Malta", "Europe/Dublin", "Europe/Berlin",
          "Europe/Paris", "Europe/Madrid", "Europe/Rome", "Europe/Amsterdam",
          "Europe/Brussels", "Europe/Vienna", "Europe/Lisbon", "Europe/Athens",
          "Europe/Helsinki", "Europe/Bratislava", "Europe/Ljubljana", "Europe/Riga",
          "Europe/Vilnius", "Europe/Tallinn", "Europe/Luxembourg", "Europe/Nicosia",
          "Europe/Zagreb",
        ];
        var MAP = [
          ["£499", "€549"],
          ["£299", "€299"],
          ["£200", "€250"],
          ["£25/month", "€29/month"],
          ["£150", "€175"],
        ];
        try {
          var tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
          if (EUR_TZ.indexOf(tz) === -1) return;
          var walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
          var nodes = [], n;
          while ((n = walker.nextNode())) if (n.nodeValue.indexOf("£") !== -1) nodes.push(n);
          nodes.forEach(function (node) {
            var t = node.nodeValue;
            MAP.forEach(function (p) { t = t.split(p[0]).join(p[1]); });
            node.nodeValue = t;
          });
        } catch (e) { /* default GBP */ }
      })();
    </script>
  </body>
</html>
